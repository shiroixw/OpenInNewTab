#!/usr/bin/env sh
STAGED=$(git diff --cached --name-only --diff-filter=ACM)

# Type-check the opted-in JS surfaces whenever JS or the tsconfig changes.
# tsconfig.json keeps `checkJs` off; files opt in with `// @ts-check`, so
# coverage grows one file at a time without a flag day.
if echo "$STAGED" | grep -qE '\.(js|mjs)$|^tsconfig\.json$'; then
	if ! npm run --silent lint:tsc; then
		echo ""
		echo "Hint: lint:tsc failed. Add the missing types, or drop the"
		echo "'// @ts-check' opt-in from a file you are not ready to cover."
		exit 1
	fi
fi

# Verify version invariants whenever a versioned tree is touched.
# Scope (post-decoupling):
#   extension/manifest.json  ==  website <meta name="app-version" />
#   userscript // @version   ==  userscript SCRIPT_VERSION constant
# Extension and userscript are independent — no cross-track check.
if echo "$STAGED" | grep -qE '^(extension/|userscript/|website/)'; then
	if ! npm run --silent version:verify; then
		echo ""
		echo "Hint: version:verify failed. Use one of"
		echo "  npm run version:bump:ext   (bump manifest + sync website meta)"
		echo "  npm run version:bump:us    (bump // @version + SCRIPT_VERSION)"
		echo "or set the versions manually in the affected files."
		exit 1
	fi
fi

if echo "$STAGED" | grep -qE '^extension/'; then
	npm run pack:extension
fi
