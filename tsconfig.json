{
    "compilerOptions": {
        "noEmit": true,
        "allowJs": true,
        "checkJs": false,
        "skipLibCheck": true,
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler"
    },
    "include": [
        "extension/**/*.js",
        "userscript/**/*.js",
        "website/**/*.js",
        "shared/**/*.js",
        "scripts/**/*.mjs",
        "tests/**/*.mjs"
    ],
    "exclude": [
        "node_modules",
        "release",
        "extension/i18n-bundle.js",
        "website/i18n.js"
    ]
}
